# Lấy token từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-token
# Để trống lần đầu, chạy bot rồi gửi /start để biết chat id của bạn
TELEGRAM_CHAT_ID=

# Theo dõi Telegram channel: lấy tại https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Tùy chọn: tăng giới hạn GitHub API cho /research (60 -> 5000 request/giờ, tìm repo 10 -> 30 lần/phút).
# Tạo fine-grained token KHÔNG cần quyền gì: https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=
